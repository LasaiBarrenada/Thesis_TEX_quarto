  ISSN = {1756-1833 0959-8138},
  JOURNALTITLE = {BMJ (Clinical research ed.)},
  KEYWORDS = {*Models Theoretical,Coronavirus,Coronavirus Infections/*diagnosis,COVID-19,Disease Progression,Hospitalization/statistics & numerical data,Humans,Multivariate Analysis,Pandemics,Pneumonia Viral/*diagnosis,Prognosis},
