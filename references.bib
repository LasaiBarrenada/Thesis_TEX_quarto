  ISSN = {0895-4356},
  JOURNALTITLE = {Journal of Clinical Epidemiology},
  KEYWORDS = {machine learning,Machine learning,methodology,Methodology,notion,oncology,Oncology,prediction model,Prediction model,sample size,Sample size,systematic review,Systematic review},
  PAGES = {111675},
