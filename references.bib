  ISSN = {1469-0705},
  JOURNALTITLE = {Ultrasound in Obstetrics \& Gynecology: The Official Journal of the International Society of Ultrasound in Obstetrics and Gynecology},
  KEYWORDS = {adnexa disease,Adnexal Diseases,Biomarkers,Biomarkers Tumor,CELL-FREE DNA,clinical decision making,Clinical Decision-Making,COMPUTED-TOMOGRAPHY SCANS,consensus,Consensus,EPIDIDYMIS PROTEIN 4,evidence based medicine,Evidence-Based Medicine,female,Female,gynecologic surgery,Gynecologic Surgical Procedures,gynecology,Gynecology,human,Humans,IOTA SIMPLE RULES,LOGISTIC-REGRESSION MODEL,MALIGNANCY ALGORITHM ROMA,Medical,medical society,MULTICENTER EXTERNAL VALIDATION,Ovarian Neoplasms,ovary tumor,PERITONEAL CARCINOMATOSIS INDEX,preoperative period,Preoperative Period,RETROSPECTIVE COHORT ANALYSIS,Societies,Societies Medical,SUBOPTIMAL CYTOREDUCTIVE SURGERY,Tumor,tumor marker},
