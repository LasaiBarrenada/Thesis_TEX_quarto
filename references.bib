  JOURNALTITLE = {Advanced biomedical research},
  KEYWORDS = {Biological,Malignancies,Ovarian Cancer,OVARIAN-CANCER,RISK,tumor marker CA125,Tumor Markers,Tumor Markers Biological,ultrasound},
  LANGID = {english},
