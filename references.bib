  ISSN = {2044-6055},
  JOURNALTITLE = {BMJ Open},
  NUMBER = {10},
  TITLE = {Head-to-head comparison of the RMI and ADNEX models to estimate the risk of ovarian malignancy: a systematic review and meta-analysis of external validation studies},
  VOLUME = {15},
}

