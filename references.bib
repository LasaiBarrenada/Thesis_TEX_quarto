  NUMBER = {4},
  PAGES = {383--390},
  TITLE = {Equally Valid Models Gave Divergent Predictions for Mortality in Acute Myocardial Infarction Patients in a Comparison of Logical Regression Models},
  URLDATE = {2024-03-25},
  VOLUME = {58},
}

