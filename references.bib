  KEYWORDS = {Biometry,Biostatistics,Cooperative Behavior,Epidemiologic Methods,Epidemiology,guidance for analysis,Guidelines as Topic,Humans,level of statistical knowledge,observational studies,Observational Studies as Topic,Research Design,Statistics as Topic},
