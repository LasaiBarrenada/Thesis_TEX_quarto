  ISSN = {1097-0258},
  JOURNALTITLE = {Statistics in Medicine},
  KEYWORDS = {calibration,Calibration,Computer Simulation,external validation,Humans,Models Statistical,prediction model,Prognosis,sample size,Sample Size,time-to-event & survival data},
  LANGID = {english},
