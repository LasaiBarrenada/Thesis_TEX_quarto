  JOURNALTITLE = {Journal of Obstetrics and Gynaecology Research},
  KEYWORDS = {*Adnexal Diseases/pathology,*Ovarian Neoplasms/pathology,adnexa disease,adult,article,benign disease of ovary and fallopian tubes,cancer model,cancer risk,controlled study,DIAGNOSIS,epithelial cancer of the ovary,Fallopian tube,female,Female,gynecologic imaging,gynecologic imaging reporting and data system,human,Humans,major clinical study,MALIGNANCY,ovary cancer,ovary disease,prediction,preoperative evaluation,Prospective Studies,prospective study,receiver operating characteristic,RISK,risk assessment,Risk Factors,Sensitivity and Specificity,surgery,Ultrasonography},
  LANGID = {english},
