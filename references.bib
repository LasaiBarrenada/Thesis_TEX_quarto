  KEYWORDS = {Adult,Aged,Aged 80 and over,Carcinoma Endometrioid,Cohort Studies,decision support model,diagnostic imaging,endometrial neoplasm,Endometrial Neoplasms,Female,Humans,Linear Models,Lymph Nodes,lymphatic metastasis,Lymphatic Metastasis,Middle Aged,neoplasm staging,Neoplasm Staging,Prospective Studies,Risk Factors,Sensitivity and Specificity,ultrasonography,Ultrasonography},
  LANGID = {english},
