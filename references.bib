  JOURNALTITLE = {The Journal of the American Association of Gynecologic Laparoscopists},
  KEYWORDS = {Adnexal Diseases,Aged,Female,Gynecologic Surgical Procedures,Hospital Charges,Humans,Laparoscopy,Laparotomy,Middle Aged,Treatment Outcome},
