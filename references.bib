  ISSN = {1067-5027},
  JOURNALTITLE = {Journal of the American Medical Informatics Association},
  NUMBER = {6},
  PAGES = {1052--1061},
  TITLE = {Calibration Drift in Regression and Machine Learning Models for Acute Kidney Injury},
  URLDATE = {2024-05-15},
  VOLUME = {24},
}

