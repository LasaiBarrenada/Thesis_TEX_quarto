  JOURNALTITLE = {Ultrasound in obstetrics \& gynecology : the official journal of the International Society of Ultrasound in Obstetrics and Gynecology},
  KEYWORDS = {*Neoplasm Staging,80 and over,ADNEX model,adnexa disease,Adnexal Diseases,Adnexal Diseases/*diagnostic imaging/pathology,adolescent,Adolescent,adult,Adult,aged,Aged,Aged 80 and over,BENIGN,BORDERLINE,CA-125,cancer staging,comparative study,diagnostic imaging,diagnostic test accuracy,echography,female,Female,human,Humans,INDEX,LR2,MENOPAUSAL STATUS,middle aged,Middle Aged,Models,Models Theoretical,MULTICENTER,Neoplasm Staging,Netherlands,ovarian carcinoma,Ovarian Neoplasms,Ovarian Neoplasms/diagnostic imaging/pathology,OVARIAN-CANCER,ovary tumor,pathology,PREOPERATIVE DIAGNOSIS,reproducibility,Reproducibility of Results,Retrospective Studies,retrospective study,risk assessment,Risk Assessment,RMI,simple rules,subjective assessment,SURGERY,Theoretical,theoretical model,TUMORS,Ultrasonography,very elderly,young adult,Young Adult},
