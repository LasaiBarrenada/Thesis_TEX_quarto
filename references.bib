  PAGES = {1723--1736},
  SHORTTITLE = {Does Ignoring Clustering in Multicenter Data Influence the Performance of Prediction Models?},
  TITLE = {Does Ignoring Clustering in Multicenter Data Influence the Performance of Prediction Models? {{A}} Simulation Study},
