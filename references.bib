@article{bakerUsingRelativeUtility2009,
  title = {Using {{Relative Utility Curves}} to {{Evaluate Risk Prediction}}},
  author = {Baker, Stuart G. and Cook, Nancy R. and Vickers, Andrew and Kramer, Barnett S.},
  year = {2009},
  month = oct,
  journal = {Journal of the Royal Statistical Society Series A: Statistics in Society},
  volume = {172},
  number = {4},
  pages = {729--748},
  issn = {0964-1998},
  doi = {10.1111/j.1467-985X.2009.00592.x},
  urldate = {2023-05-18},
  abstract = {Because many medical decisions are based on risk prediction models that are constructed from medical history and results of tests, the evaluation of these prediction models is important. This paper makes five contributions to this evaluation: the relative utility curve which gauges the potential for better prediction in terms of utilities, without the need for a reference level for one utility, while providing a sensitivity analysis for misspecification of utilities, the relevant region, which is the set of values of prediction performance that are consistent with the recommended treatment status in the absence of prediction, the test threshold, which is the minimum number of tests that would be traded for a true positive prediction in order for the expected utility to be non-negative, the evaluation of two-stage predictions that reduce test costs and connections between various measures of performance of prediction. An application involving the risk of cardiovascular disease is discussed.},
  file = {C\:\\Users\\u0158158\\Zotero\\storage\\WULL8CEF\\Baker et al. - 2009 - Using Relative Utility Curves to Evaluate Risk Pre.pdf;C\:\\Users\\u0158158\\Zotero\\storage\\9IFHKYVZ\\7084571.html}
}

