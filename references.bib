  FILE = {C:\Users\u0158158\Zotero\storage\74MDWI8T\Riley et al. - 2019 - Minimum sample size for developing a multivariable prediction model PART II ‐ binary and time‐to‐ev.pdf},
  ISSN = {0277-6715},
  JOURNALTITLE = {Statistics in Medicine},
  KEYWORDS = {binary and time-to-event outcomes,Computer Simulation,Humans,logistic and Cox regression,multivariable prediction model,Multivariate Analysis,pseudo R-squared,Regression Analysis,sample size,Sample Size,shrinkage,Time},
  NUMBER = {7},
  PAGES = {1276--1296},
  SHORTJOURNAL = {Stat Med},
