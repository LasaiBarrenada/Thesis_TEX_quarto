  ISSN = {1756-1833},
  JOURNALTITLE = {BMJ},
  LANGID = {english},
  PAGES = {e071018},
  SHORTTITLE = {Transparent Reporting of Multivariable Prediction Models Developed or Validated Using Clustered Data},
