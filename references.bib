  ISSN = {1873-7560},
  JOURNALTITLE = {European Urology},
  KEYWORDS = {Attitude of Health Personnel,Biopsy,Clinical Decision-Making,Clinical utility,Comprehension,Decision curve analysis,Decision Support Techniques,Digital Rectal Examination,Health Knowledge Attitudes Practice,Humans,Kallikreins,Male,Neoplasm Grading,Net benefit,Patient Selection,Predictive Value of Tests,Prostate-Specific Antigen,Prostatic Neoplasms,Risk Assessment,Risk Factors,Risk prediction models,Risk threshold,Test tradeoff,Ultrasonography,Urologists,Urology},
