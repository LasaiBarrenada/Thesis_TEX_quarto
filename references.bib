  JOURNALTITLE = {Journal of the Royal Statistical Society Series A: Statistics in Society},
  NUMBER = {3},
  PAGES = {663--688},
  TITLE = {General and {{Specific Utility Measures}} for {{Synthetic Data}}},
  URLDATE = {2024-05-04},
