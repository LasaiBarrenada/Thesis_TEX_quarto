  DOI = {10.1007/s00330-022-08803-6},
  ISSN = {1432-1084 0938-7994},
  JOURNALTITLE = {European radiology},
  KEYWORDS = {*Adnexal Diseases/diagnostic imaging/pathology,*Ovarian Neoplasms/pathology,ADNEX model,adnexa cancer,adnexa disease,Adnexa Uteri,Adnexa Uteri/pathology,Adnexal diseases,Adnexal Diseases,adult,aged,article,Article,benign neoplasm,cancer classification,cancer surgery,controlled study,DATA SYSTEM,diagnostic imaging,diagnostic test accuracy study,diagnostic value,echography,EXTERNAL VALIDATION,female,Female,gynecologic imaging reporting and data system,gynecologist,human,Humans,intermethod comparison,major clinical study,MASSES,model,MULTICENTER,Ovarian Neoplasms,OVARIAN-CANCER,ovary tumor,pathology,Retrospective Studies,retrospective study,RISK,ROC curve,RULES,sensitivity and specificity,Sensitivity and specificity,Sensitivity and Specificity,SURGERY,Ultrasonography,uterine adnexa,uterus cancer,validity},
