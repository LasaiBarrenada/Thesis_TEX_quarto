  KEYWORDS = {Breast cancer,Classification algorithms,decision tree,Decision trees,ensemble learning,machine learning,Machine learning,Machine learning algorithms,random forest,Training},
  PAGES = {449--452},
  TITLE = {Using {{Random Forest Algorithm}} for {{Breast Cancer Diagnosis}}},
