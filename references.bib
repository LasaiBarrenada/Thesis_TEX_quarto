  ISSN = {0306-5456},
  JOURNALTITLE = {British Journal of Obstetrics and Gynaecology},
  KEYWORDS = {Adult,Age Factors,Aged,Antigens Tumor-Associated Carbohydrate,Diagnosis Differential,Female,Humans,Menopause,Middle Aged,Ovarian Diseases,Ovarian Neoplasms,Radioimmunoassay,Regression Analysis,Risk Factors,Ultrasonography,Uterus},
  LANGID = {english},
