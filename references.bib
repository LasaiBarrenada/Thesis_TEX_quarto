  JOURNALTITLE = {Ultrasound in Obstetrics and Gynecology},
  KEYWORDS = {ADNEX model,aged,Aged,Biopsy,Breast Neoplasms,Breast Neoplasms/*diagnosis/pathology,breast tumor,CA 125 antigen,CA-125 Antigen,CA-125 Antigen/metabolism,CARCINOMA,Colorectal Neoplasms,Colorectal Neoplasms/*diagnosis/pathology,colorectal tumor,diagnostic imaging,DISEASE,DISTANT METASTASES,DOPPLER,echography,FEATURES,female,Female,human,Humans,image guided biopsy,Image-Guided Biopsy,metabolism,metastasis,metastatic non-ovarian cancer,middle aged,Middle Aged,NEEDLE-ASPIRATION-CYTOLOGY,Neoplasm Metastasis,Ovarian Neoplasms,Ovarian Neoplasms/*diagnostic imaging/pathology/secondary,ovary tumor,pathology,primary ovarian cancer,Prospective Studies,prospective study,receiver operating characteristic,ROC Curve,secondary,sensitivity and specificity,Sensitivity and Specificity,Stomach Neoplasms,Stomach Neoplasms/*diagnosis/pathology,stomach tumor,TUMORS,Ultrasonography,ultrasound-guided tru-cut biopsy},
