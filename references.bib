  ISSN = {1932-6157},
  JOURNALTITLE = {The Annals of Applied Statistics},
  KEYWORDS = {Bayesian information criterion (BIC),cost-adjusted BIC,cost-benefit analysis,Input-output analysis,Laplace approximation,MCMC model composition (MC^3),quality of health care,reversible-jump Markov chain Monte Carlo (RJMCMC) methods,sickness at hospital admission},
