  SHORTJOURNAL = {Ultrasound Obstet Gynecol},
  TITLE = {Validation of {{ADNEX}} and {{IOTA}} Two-Step Strategy and Estimation of Risk of Complications during Follow-up of Adnexal Masses in Low-Risk Population},
