  JOURNALTITLE = {Ultrasound in Obstetrics \& Gynecology: The Official Journal of the International Society of Ultrasound in Obstetrics and Gynecology},
  KEYWORDS = {ADNEX,Adnexal Diseases,adnexal lesion,Adult,Aged,CA-125 Antigen,Female,Follow-Up Studies,Humans,IOTA two‐step strategy,Membrane Proteins,Middle Aged,ovarian cancer,Ovarian Neoplasms,Prospective Studies,Risk Assessment,Spain,Ultrasonography,ultrasound},
  LANGID = {english},
