@ARTICLE{moonsPROBASTToolAssess2019,
  ABSTRACT = {Prediction models in health care use predictors to estimate for an individual the probability that a condition or disease is already present (diagnostic model) or will occur in the future (prognostic model). Publications on prediction models have become more common in recent years, and competing prediction models frequently exist for the same outcome or target population. Health care providers, guideline developers, and policymakers are often unsure which model to use or recommend, and in which persons or settings. Hence, systematic reviews of these studies are increasingly demanded, required, and performed. A key part of a systematic review of prediction models is examination of risk of bias and applicability to the intended population and setting. To help reviewers with this process, the authors developed PROBAST (Prediction model Risk Of Bias ASsessment Tool) for studies developing, validating, or updating (for example, extending) prediction models, both diagnostic and prognostic. PROBAST was developed through a consensus process involving a group of experts in the field. It includes 20 signaling questions across 4 domains (participants, predictors, outcome, and analysis). This explanation and elaboration document describes the rationale for including each domain and signaling question and guides researchers, reviewers, readers, and guideline developers in how to use them to assess risk of bias and applicability concerns. All concepts are illustrated with published examples across different topics. The latest version of the PROBAST checklist, accompanying documents, and filled-in examples can be downloaded from www.probast.org.},
  AUTHOR = {Moons, Karel G. M. and Wolff, Robert F. and Riley, Richard D. and Whiting, Penny F. and Westwood, Marie and Collins, Gary S. and Reitsma, Johannes B. and Kleijnen, Jos and Mallett, Sue},
  DATE = {2019-01},
  DOI = {10.7326/M18-1377},
  FILE = {C:\Users\u0158158\Zotero\storage\5YF3HKPC\Moons et al. - 2019 - PROBAST A Tool to Assess Risk of Bias and Applica.pdf},
  ISSN = {1539-3704},
  JOURNALTITLE = {Annals of Internal Medicine},
  KEYWORDS = {Bias,Decision Support Techniques,Diagnosis,Humans,Models Statistical,Prognosis,Research Design,Systematic Reviews as Topic},
  LANGID = {english},
  NUMBER = {1},
  PAGES = {W1--W33},
  SHORTTITLE = {{{PROBAST}}},
  TITLE = {{{PROBAST}}: {{A Tool}} to {{Assess Risk}} of {{Bias}} and {{Applicability}} of {{Prediction Model Studies}}: {{Explanation}} and {{Elaboration}}},
  VOLUME = {170},
}

@ARTICLE{moroExternalValidationUltrasoundbased2025,
  ABSTRACT = {OBJECTIVE: To prospectively validate the performance of the Risk of Malignancy Index (RMI), the International Ovarian Tumor Analysis (IOTA) Simple Rules Risk Model (SRRisk), the IOTA Assessment of Different NEoplasias in the adneXa (ADNEX) model, and the IOTA two-step strategy across different types of ultrasound centers in Italy. A retrospective post hoc analysis estimates malignancy prevalence in Ovarian-Adnexal Reporting and Data System (O-RADS) risk groups when using the two-step strategy or the O-RADS lexicon. METHODS: This is a multicenter prospective observational study including regional referral centers and district hospitals in Italy. Consecutive patients with an adnexal mass examined with ultrasound by an IOTA certified gynecologist with different levels of expertise were included, provided they underwent surgery {$<$} 180 days after the inclusion scan. Ultrasound examination was performed transvaginally or transrectally and was supplemented with an abdominal scan when necessary. Reference standard was the histology of the adnexal mass following surgical removal. Discrimination (area under receiver operating characteristic curve, AUROC), calibration, and clinical utility were assessed to illustrate the diagnostic performance of the methods. For the retrospective post hoc analysis, we report the prevalence of malignancy in the O-RADS risk groups (O-RADS 2: risk of malignancy {$<$}1\%; O-RADS 3: risk of malignancy 1\% to {$<$}10\%; O-RADS 4: risk of malignancy 10\% to {$<$}50\%; O-RADS 5: risk of malignancy {$\geq$}50\%), with the O-RADS risk group assigned using either the two-step strategy or the O-RADS lexicon. RESULTS: Between May 2017 and March 2020, 1,431 patients were enrolled from 21 Italian centers (10 oncological and 11 non-oncological). Based on histology, 995 (69.5\%) tumors were benign and 436 (30.5\%) were malignant (115, 8.0\% borderline, 263, 18.4\% primary invasive, 58, 4.1\% metastatic tumors). For RMI, the AUROC was 0.85 (95\% confidence interval [CI] 0.81-0.87), whereas for all IOTA models (SRRisk, ADNEX with and without CA125, two step strategy with and without CA125) the AUROCs ranged from 0.91 (95\% CI: 0.88-0.93) to 0.92 (95\% CI: 0.89-0.94). All IOTA models demonstrated a higher net benefit than RMI across risk thresholds (exchange rates) from 1\% to 50\%. All IOTA models slightly underestimated the risk of malignancy, but SRRisk showed the least degree of underestimation. The prevalence of malignancy and the corresponding 95\% CI in the four O-RADS risk categories, as calculated using the two-step strategy and O-RADS lexicon were 0.97\% (95\%CI 0.4-2.6) and 1.2\% (95\%CI 0.5-2.9) for O-RADS 2, 7.2\% (95\%CI 5.0-10.3) and 6.0\% (95\%CI 3.6-9.6) for O-RADS 3, 37.9\% (95\%CI 32.4-43.8) and 27.8\% (95\%CI 23.6-32.5) for O-RADS 4, and 84\% (95\%CI 79.8-87.4) and 83.1\% (95\%CI 79.0-86.6) for O-RADS 5. CONCLUSIONS: RMI had lower ability than the IOTA models to distinguish between benign and malignant adnexal tumours in patients examined by either expert or non-expert ultrasound operators in Italy. All the IOTA models-including SRRisk, ADNEX, and the two-step strategy with or without CA125-had similar ability. The prevalence of malignancy in each of the four O-RADS risk categories closely matched the assigned malignancy risk regardless of whether the two-step strategy or O-RADS lexicon was used.},
  AUTHOR = {Moro, Francesca and Momi, Marina and Ledger, Ashleigh and Barreñada, Lasai and Ceusters, Jolien and Sturla, Davide and Mor, Elisa and Fornari, Letizia and Mascilini, Floriana and Ciccarone, Francesca and Pozzati, Federica and Froyman, Wouter and Van Calster, Ben and Bourne, Tom and Timmerman, Dirk and Fagotti, Anna and Valentin, Lil and Testa, Antonia Carla and {IOTA 6 Collaborators}},
