@article{harterImpactStructuredQuality2011,
  title = {Impact of a Structured Quality Management Program on Surgical Outcome in Primary Advanced Ovarian Cancer},
  author = {Harter, Philipp and Muallem, Zelal M. and Buhrmann, Christine and Lorenz, Dietmar and Kaub, Christine and Hils, Rita and Kommoss, Stefan and Heitz, Florian and Traut, Alexander and {du Bois}, Andreas},
  year = {2011},
  month = jun,
  journal = {Gynecologic Oncology},
  volume = {121},
  number = {3},
  pages = {615--619},
  issn = {1095-6859},
  doi = {10.1016/j.ygyno.2011.02.014},
  abstract = {OBJECTIVE: Surgical outcome in advanced ovarian cancer (AOC) is an important prognostic factor and the only factor amendable to improvement by optimization. Therefore, introduction of quality management programs (QM) regarding the surgical therapy in ovarian cancer may help to improve outcome. METHODS: We introduced a specific ovarian cancer quality management program in 2001 in our gynecologic oncology center. Analysis of 396 consecutive patients with primary surgery for advanced ovarian cancer FIGO stages IIB-IV operated before the introduction of the quality management program 1997-2000, or during the introduction years 2001-2003, or after establishing 2004-2008. RESULTS: Thirty-three percent had complete debulking to no macroscopic residual disease from 1997 to 2000. This rate increased to 47\% in 2001-2003 (n = 86) and 62\% in 2004-2008 (n = 259). The utilization of extended surgical procedures increased over time. Patients with complete resection had 5-YSR of 55\% compared to 16\% in patients with residuals 1-10 mm, and 13\% in patients with residuals {$>$}1 cm (p {$<$} 0.001). The median OS increased from 26 months 1997-2000 to 37 months 2001-2003 and 45 months in 2004-2008 (p {$<$} 0.003). CONCLUSIONS: Optimizing surgical skills, infrastructure, and introduction of quality management programs may improve both surgical and overall outcome in advanced ovarian cancer.},
  langid = {english},
  pmid = {21414656},
  keywords = {Adult,Aged,Aged 80 and over,Female,Gynecologic Surgical Procedures,Humans,Middle Aged,Neoplasm Residual,Neoplasm Staging,Ovarian Neoplasms,Quality Assurance Health Care,Survival Rate,Treatment Outcome,Young Adult}
}

